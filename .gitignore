# Carpeta de trabajo para evaluaciones reales
evaluaciones/

# Exportaciones generadas por la aplicación (nombre: evaluacion_<estudiante>.json / .csv)
evaluacion_*.json
evaluacion_*.csv

# Cualquier CSV y cualquier JSON, salvo las rúbricas versionadas
*.csv
*.json
!rubricas/*.json

